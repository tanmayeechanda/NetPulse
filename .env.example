# NetPulse configuration
# Copy this file to .env and adjust. docker-compose reads .env automatically,
# and the backend also loads it when you run it directly (python run.py).

# Network interface for ARP scans and packet capture.
# Linux/Docker: eth0, wlan0, enp3s0...  Windows: "Wi-Fi", "Ethernet".
# Leave empty to auto-detect. An unknown name logs a warning and falls back to auto-detect.
SCAN_INTERFACE=eth0

# Worker threads for the ping-sweep fallback and reverse-DNS lookups (1-256).
MAX_SCAN_THREADS=10

# Where the browser reaches the backend API. Baked into the frontend at build time,
# so rebuild after changing it: docker-compose up --build
REACT_APP_API_URL=http://localhost:8000

# Optional: override the auto-detected subnet, e.g. 192.168.1.0/24
# NETPULSE_SUBNET=
